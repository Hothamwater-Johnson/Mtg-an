# Copy this file to .env.local — NEVER commit .env.local (it is in .gitignore).
# All keys below are required in production. Missing keys = runtime errors.

# ── LOCAL DEV ─────────────────────────────────────────────────────────────────
# Run `npm run supabase:start` then `supabase status` to get these values.
# The anon key and service role key are stable per project_id in config.toml.
#
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `supabase status`>
# SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>
#
# For Stripe webhooks locally:
#   1. Install Stripe CLI: https://stripe.com/docs/stripe-cli
#   2. Run: npm run stripe:listen
#   3. Copy the whsec_ secret printed to terminal into STRIPE_WEBHOOK_SECRET below
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` output
#
# Emails are logged to terminal in dev (NODE_ENV=development) — no Resend key needed.
# RESEND_API_KEY=re_dev_placeholder
# RESEND_FROM_EMAIL=proposals@localhost
#
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# CRON_SECRET=local-dev-cron-secret-32-chars-min

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # safe to expose — enforces RLS
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # KEEP SECRET — bypasses RLS

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...          # KEEP SECRET
STRIPE_WEBHOOK_SECRET=whsec_...        # from Stripe dashboard → Webhooks
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_PACK_5=price_...
STRIPE_PRICE_PACK_15=price_...

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...                  # KEEP SECRET
RESEND_FROM_EMAIL=proposals@yourdomain.com

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Cron (set a random 32+ char string, add to Vercel env) ───────────────────
CRON_SECRET=replace-with-random-32-char-string
